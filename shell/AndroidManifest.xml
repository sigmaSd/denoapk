<?xml version="1.0" encoding="utf-8"?>
<!--
  Reference manifest for the shell.

  Not compiled directly — src/build.ts's manifestFor() generates the real one
  per app (see that file for why: aapt2 link is fast enough to just regenerate
  and compile from source rather than binary-patch a template). This copy
  exists so the shell's Java sources have a matching manifest to build and
  test against standalone, and stays in sync with manifestFor() by hand.

  `android:name` on the activity is FULLY QUALIFIED. A leading-dot name
  resolves against the manifest `package` attribute, which changes per app —
  spelling it out is what makes renaming the package safe.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="dev.denapk.shell">
  <uses-permission android:name="android.permission.INTERNET" />

  <application
    android:label="denapk app"
    android:icon="@mipmap/ic_launcher"
    android:usesCleartextTraffic="false"
    android:allowBackup="true"
    android:supportsRtl="true"
    android:theme="@android:style/Theme.Material.NoActionBar">
    <!--
      The shell shows a single full-bleed WebView. The default theme's
      ActionBar would draw the app label as a second, native header on top of
      the page's own — NoActionBar removes it rather than sizing around it.
    -->
    <activity
      android:name="dev.denapk.shell.MainActivity"
      android:exported="true"
      android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
